# GitHub App credentials
# Get these after creating your GitHub App at https://github.com/organizations/<YOUR_ORG>/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# ── AI Provider ──────────────────────────────────────────────────────
# Set ONE of the two API keys below. Vigil auto-detects the provider
# from whichever key is present. To be explicit, set AI_PROVIDER too.

# Option A: Anthropic (default) — supports prompt caching for lower token costs
ANTHROPIC_API_KEY=

# Option B: OpenAI
# OPENAI_API_KEY=

# Optional overrides
# AI_PROVIDER=anthropic        # Force provider: "anthropic" or "openai"
# AI_MODEL=claude-sonnet-4-6   # Override model (default: claude-sonnet-4-6 / gpt-4o)

# Server config
PORT=3000
NODE_ENV=production

# SQLite DB path for context cache
DB_PATH=./data/context.db
